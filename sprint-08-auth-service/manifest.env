# Record the service, security review and test values chosen by your team.
SRC_DIR=src
EXTRA_TEST_DIR=test
SERVICE_HOST=localhost
SERVICE_PORT=3000
OPENAPI_DOCS_PATH=/docs
OPENAPI_JSON_PATH=/docs/json
GUARD_SPEC_PATTERN='guard|token'
GUARD_EXPIRED_TEST_PATTERN='expired'
GUARD_SIGNATURE_TEST_PATTERN='signature|forged|tampered|wrong key'
CREDENTIAL_FIELD_NAMES="password passwordHash plainPassword refreshToken accessToken"
LOG_CALL_PATTERN='(console|logger|log)\.(log|info|warn|error|debug|verbose|fatal|trace)[[:space:]]*\('
SECURITY_REVIEW_FILE=security-review/REVIEW.md
SECURITY_REVIEW_TEMPLATE=security-review/TEMPLATE.md
SECURITY_REVIEW_CATEGORIES="A01 A02 A03 A04 A05 A06 A07 A09"
SECURITY_REVIEW_NONE_MIN_WORDS=8
ROTATION_REVOCATION=enforced
ROTATION_DECISION_PATTERN='revok|rotat|refresh token'
ROTATION_DECISION_MIN_WORDS=12
DEMO_USERNAME=demo1
DEMO_PASSWORD='Trainee#2026'
DEMO_ACCOUNT_ID=1
UNKNOWN_USERNAME=no-such-user-for-review
WRONG_PASSWORD=not-the-password-for-this-user
UNIFORM_TIMING_ATTEMPTS=5
UNIFORM_TIMING_THRESHOLD_MS=400
UNIFORM_TIMING_RATIO=2
UNIFORM_TIMING_FLOOR_MS=5
THROTTLE_COOLDOWN_SECONDS=0
POSTGRES_CONTAINER=postgres
PG_DATABASE=trading
PG_USER=postgres
STORED_HASH_SQL="SELECT password_hash FROM auth.users WHERE username = '${DEMO_USERNAME}' LIMIT 1"
TRADE_API_HOST=localhost
TRADE_API_PORT=8080
TRADE_API_PROTECTED_PATH=/api/v1/accounts/${DEMO_ACCOUNT_ID}
TRADE_API_DIR=../sprint-06-trade-api
TRADE_API_ISSUER_CONFIG_KEYS="JWT_SECRET JWT_REQUIRED_ISSUER"
