# Record the workspace, generated client and test values chosen by your team.
SRC_DIR=src
PACKAGE_FILE=package.json
LOCK_FILE=package-lock.json
WORKSPACE_CONFIG=angular.json
PLAYWRIGHT_CONFIG=playwright.config.ts
DIST_DIR=dist/trading-ui/browser
BUILD_OUTPUT_ROOT=dist
E2E_DIR=e2e
GENERATOR_CONFIG=openapitools.json
GENERATE_COMMAND='npm run generate'
GENERATOR_CLI_BIN=node_modules/.bin/openapi-generator-cli
GENERATED_CLIENT_DIR=src/app/core/api
GENERATOR_MARKER='auto.generated by OpenAPI Generator'
GENERATED_IMPORT_TOKEN='core/api'
CONTRACTS_DIR=../contracts
CONTRACT_FILES="trade-api.yaml auth-api.yaml"
ERROR_MAPPING_FILE=src/app/core/errors/error-catalogue.ts
INTERCEPTOR_FILE=src/app/core/interceptors/auth-interceptor.ts
INTERCEPTOR_SPEC_PATTERN='interceptor'
INTERCEPTOR_ATTACH_TEST_PATTERN='attach|adds the (bearer|token|header)|sets the authorization'
INTERCEPTOR_NO_ATTACH_TEST_PATTERN='does not attach|never attaches|without a token|no token|third.party|other origin|external|fauxnance'
BUNDLE_API_KEY_PATTERN='x-api-key|api[_-]key|fauxnance'
BUNDLE_FAUXNANCE_URL_PATTERN='execute-api\.[a-z0-9-]+\.amazonaws\.com'
BUNDLE_SECRET_PATTERN='jwt[_-]?secret|secret[^A-Za-z0-9]{0,4}["'"'"'][A-Za-z0-9_+/=-]{24,}["'"'"']|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
ROOT_ENV_FILE=../.env
UI_BASE_URL=http://localhost:4200
TRADE_API_BASE_URL=http://localhost:8080
AUTH_API_BASE_URL=http://localhost:3000
E2E_LOGIN_SPEC=e2e/login.spec.ts
E2E_PLACE_ORDER_SPEC=e2e/place-order.spec.ts
E2E_EXTRA_SPEC=
DEMO_USERNAME=demo1
DEMO_PASSWORD='Trainee#2026'
DEMO_ACCOUNT_ID=1
DEMO_SYMBOL=AAPL
LOGIN_THROTTLE_COOLDOWN_SECONDS=0
GUARDED_ROUTE=/orders
LOGIN_ROUTE=/login
LOGIN_USERNAME_SELECTOR='[data-testid="login-username"], #username, input[name="username"]'
LOGIN_PASSWORD_SELECTOR='[data-testid="login-password"], #password, input[name="password"]'
LOGIN_SUBMIT_SELECTOR='[data-testid="login-submit"], button[type="submit"]'
