# Record the deployment and review values chosen by your team.
CLOUDFRONT_DOMAIN=CHANGE_ME
BUCKET_NAME=CHANGE_ME
AWS_REGION=ap-south-1
DEPLOY_ENTRYPOINT=CHANGE_ME
DEPLOY_SUPPORTING_FILES=""
DEPLOY_BUILD_PATTERN='ng build|npm run build|yarn build|npm ci'
DEPLOY_UPLOAD_PATTERN='s3 sync|s3 cp|s3api put-object'
DEPLOY_INVALIDATE_PATTERN='create-invalidation'
REPO_SCAN_ROOT=..
AWS_ACCESS_KEY_ID_PATTERN='(AKIA|ASIA)[0-9A-Z]{16}'
AWS_SECRET_KEY_PATTERN='aws_secret_access_key[^A-Za-z0-9]{0,4}[A-Za-z0-9/+=]{40}'
SCAN_EXCLUDE_DIRS=".git node_modules dist target .angular .venv coverage build"
INDEX_APP_MARKER_PATTERN='<app-root|ng-version|<[a-z][a-z0-9-]*-root'
BUNDLE_FETCH_LIMIT=6
BUNDLE_API_KEY_PATTERN='x-api-key|api[_-]key|fauxnance'
BUNDLE_FAUXNANCE_URL_PATTERN='execute-api\.[a-z0-9-]+\.amazonaws\.com'
BUNDLE_SECRET_PATTERN='jwt[_-]?secret|secret[^A-Za-z0-9]{0,4}["'"'"'][A-Za-z0-9_+/=-]{24,}["'"'"']|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
